<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Xeno-canto robustness results</title>
  <style>
    @page { size: auto; margin: 0; }
    body {
      color: #24292f;
      background: #ffffff;
      font-family: Arial, sans-serif;
      font-size: 10pt;
      line-height: 1.5;
      margin: 0;
    }
    h1 { font-size: 20pt; line-height: 1.2; }
    h2 { font-size: 14pt; margin-top: 1.5em; }
    h3 { font-size: 11pt; }
    h1, h2, h3 { break-after: avoid; }
    .cell { margin-bottom: 1em; }
    .output_area { break-inside: avoid; }
    .prompt { display: none; }
    img { display: block; max-width: 100%; height: auto; }
    pre { white-space: pre-wrap; }
    code { font-family: monospace; }
    a { color: #0969da; }
    @media print {
      body { box-sizing: border-box; width: 210mm; padding: 12mm; }
    }
    @media screen {
      body { max-width: 190mm; margin: 24px auto; padding: 0 24px; }
    }
  </style>
</head>
<body>
$body
</body>
</html>
