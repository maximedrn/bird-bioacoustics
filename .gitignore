# Durable experiment state and optional reference labels.
data/*
!data/database.sqlite3
!data/annotations.csv

# Pinned benchmark metadata and source fingerprints; exclude downloaded audio.
!data/benchmark/
data/benchmark/*
!data/benchmark/ebird_2021.csv
!data/benchmark/NBP/
!data/benchmark/HSN/
data/benchmark/*/*
!data/benchmark/*/metadata.parquet
!data/benchmark/*/audio.tar.gz.sha256

# Measured results, provenance and readable exports grouped by experiment.
!data/results/
data/results/**
!data/results/**/
!data/results/**/*.csv
!data/results/**/*.json
!data/results/**/*.png
!data/results/**/*.svg
!data/results/**/*.html

# Local credentials.
.env
.env.*
!.env.example

# Keep the compiled report and experiment figures; ignore other PDFs.
*.pdf
!latex/report.pdf
!data/results/**/*.pdf
data/results/**/.*

# LaTeX intermediate files.
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*.bak*
indent.log

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# uv
.python-version

# Jupyter
.ipynb_checkpoints/

# Distribution / build
build/
dist/
*.egg-info/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Type checking / linting
.mypy_cache/
.pyright/
.ruff_cache/

# IDEs
.vscode/
.idea/

# macOS
.DS_Store
